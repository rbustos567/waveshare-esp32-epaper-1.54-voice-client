idf_component_register(
    SRC_DIRS
        "."
        "Config"
        "GUI"
        "Fonts"
        "e-Paper"
    INCLUDE_DIRS
        "."
        "Config"
        "GUI"
        "Fonts"
        "e-Paper"
    REQUIRES driver esp_timer
)

# Desactivar treat-warnings-as-errors para código de terceros
target_compile_options(${COMPONENT_LIB} PRIVATE
    -Wno-maybe-uninitialized
    -Wno-unused-variable
    -Wno-type-limits
    -Wno-format
    -Wno-error
)
